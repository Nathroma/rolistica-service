{
    "name": "rolistica-api",
    "version": "0.1.0",
    "description": "A dynamic RPG character creator and manager with auto-generated stats, intuitive guides, and expandable game-system support",
    "main": "dist/main.js",
    "scripts": {
        "build": "nest build",
        "start": "nest start --env-file .env",
        "start:dev": "nest start --watch --env-file .env",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "ts:check": "tsc --noEmit",
        "ts:fix": "tsc --noEmit --fix",
        "prettier:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "prettier:write": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prepush": "npm run prettier:check && npm run lint:check"
    },
    "author": "Nathroma",
    "license": "ISC",
    "dependencies": {
        "@nestjs/cli": "^11.0.12",
        "@nestjs/common": "^11.1.28",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mongoose": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/swagger": "^11.2.3",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "^17.4.2",
        "mongoose": "^8.8.4",
        "nestjs-zod": "^5.4.0",
        "nodemailer": "^9.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "typescript": "^5.8.3",
        "zod": "^4.1.13",
        "zod-validation-error": "^4.0.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/node": "^20.0.0",
        "@types/nodemailer": "^8.0.1",
        "@types/passport-jwt": "^4.0.1",
        "ts-node": "^10.9.0"
    }
}
