APP_API_PORT=3000 #default
APP_HOSTNAME=0.0.0.0 #default

MONGO_DB_ENDPOINT=mongodb://localhost:27017/rolistica-service

# Generate strong random secrets in production (e.g. openssl rand -base64 64)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production

# URL of the React frontend (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# SMTP — Hostinger VPS (max ~5 emails/min)
# On a Hostinger VPS, SMTP_HOST is often "localhost" if the mail server runs on the same machine.
# For Hostinger shared email: smtp.hostinger.com, port 465, SMTP_SECURE=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yourdomain.com